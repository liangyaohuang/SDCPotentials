# LAMMPS input script for CO2 simulation (EPM2 Force Field)
# Generated from GROMACS .itp and nonbonded parameters
# Date: 2025-06-23

# ==================== 1. INITIALIZATION ====================
units           real       # kcal/mol, Angstrom, fs, K, atm, g/mol
atom_style      full       # Needed for charges, bonds, angles, etc.
boundary        p p p      # Periodic boundary conditions in all directions
                           # (adjust if you have non-periodic simulations)

# ==================== 2. READ DATA FILE ====================
# This command reads the atom coordinates, types, masses, charges, and topology
# (bonds, angles, dihedrals) from the data file generated by VMD.
read_data       co2.data   # Ensure 'co2.data' is in the same directory or specify full path

# ==================== 3. FORCE FIELD DEFINITION ====================

# 3.1 Non-bonded (Lennard-Jones and Coulomb)
# We will use the 'lj/cut/coul/long' pair style for OPLS-AA like force fields.
# '10.0' is the cutoff distance for Lennard-Jones and real-space Coulombic interactions (Angstroms).
pair_style      lj/cut/coul/long 10.5

# Define Lennard-Jones parameters for each atom type pair.
# The parameters (epsilon, sigma) must be in LAMMPS 'real' units (kcal/mol, Angstroms).
# For 1-2, 1-3 non-bonded exclusions, we'll use 'special_bonds' below.

# pair_coeff I J epsilon sigma
pair_coeff      1 1  0.055895  2.757   # opls_1003 (C) - opls_1003 (C)
pair_coeff      2 2  0.159975  3.033   # opls_1004 (O) - opls_1004 (O)
pair_coeff      3 3  0.159975  3.033   # opls_1004 (O) - opls_1004 (O)
pair_coeff      1 2  0.094561  2.895   # opls_1003 (C) - opls_1004 (O) (Lorentz-Berthelot mixing)
pair_coeff      1 3  0.094561  2.895   # opls_1003 (C) - opls_1004 (O) (Lorentz-Berthelot mixing)
pair_coeff      2 3  0.159975  3.033   # opls_1004 (O) - opls_1004 (O)

# Long-range electrostatics (Ewald Summation - PPPM method)
kspace_style    pppm 1.0e-4   # pppm: Particle-Particle Particle-Mesh, 1.0e-4 is the desired precision

# 3.2 Bond Definition
bond_style      harmonic
bond_coeff      1  295.411  1.149

# 3.2 Angle Potential (O-C-O)
# GROMACS used a harmonic angle with ka=1236.00 kJ/mol/rad^2 and theta0=180.00 deg.
# Converted LAMMPS K = 295.539 kcal/mol/rad^2.
angle_style     harmonic
angle_coeff     1  295.411  180.00  # Angle type 1: O-C-O (K, theta0)

# Energy minimization (highly recommended before starting MD)
# Ensures your initial structure is stable and eliminates high-energy overlaps.
# etol: energy tolerance for convergence
# ftol: force tolerance for convergence
# maxiter: max iterations
# maxeval: max force/energy evaluations
minimize        1.0e-4 1.0e-6 1000 10000

# 3.3 Bond Constraints (C-O Bonds)
# Your GROMACS .itp file specified constraints for the C-O bonds.
# In LAMMPS, we use 'fix shake' to enforce fixed bond lengths.
# GROMACS bond length was 0.1149 nm = 1.149 Angstroms.
#
# fix ID group-ID style args...
#   shake_tol: 0.0001 (relative tolerance for bond length)
#   shake_iter: 20 (max iterations for convergence)
#   shake_freq: 0 (no diagnostic info output)
fix             shake_bonds all shake 0.0001 20 0 b 1

# 3.4 Special Bonds (Non-bonded exclusions)
special_bonds   lj/coul 0.0 0.0 0.5 # 1-2 excluded, 1-3 excluded, 1-4 scaled by 0.5

# ==================== 4. SIMULATION SETTINGS ====================

# Define an atom group for the entire system (optional, but good practice)
group           co2_mol type 1 2 3

# Initial temperature (useful if starting from non-zero temp or for NVT)
velocity        all create 270.0 12345 dist gaussian mom yes rot yes

timestep	1.0
fix		npt all npt temp 270.0 270.0 100.0 iso 3000.0 3000.0 1000.0
run		1000000
unfix		npt

# ==================== 5. THERMODYNAMIC OUTPUT & DUMP ====================

# Output thermodynamic data to screen and log file every 100 steps.
thermo          100
thermo_style    custom step temp pe ke etotal press vol density

# Dump trajectory frames to a file (optional, but good for visualization)
# dump ID group-ID style N file
dump            1 all custom 100 dumpco2.lammpstrj id mol type q mass x y z fx fy fz
dump_modify     1 sort id

# ==================== 6. RUN COMMANDS (Choose one simulation type) ====================

# Example: NVT simulation (constant Number of particles, Volume, Temperature)
# fix             ID group-ID style args...
#   nvt: Nose-Hoover thermostat and barostat
#   temp: start_temp end_temp damping_parameter (in fs)
fix             2 all nvt temp 270.0 270.0 100.0 # Maintain temperature at 295K, damping 100fs

# Example: NPT simulation (constant Number of particles, Pressure, Temperature)
# fix             3 all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0 # Isotropic pressure control at 1.0 atm

# Run command
reset_timestep	0
timestep        2.0        # fs (already defined at top, typically for MD simulations)
run             5000000      # Run for 10,000,000 timesteps

# Write restart file (optional)
# write_restart   co2.restart

print "Simulation finished successfully!"
