# Define the filenames
file1="dumpco2.lammpstrj"
file2="Pair_CO2-CO2.table"
file3="log.lammps"

# Function to rename files
rename_file() {
    local filename=$1
    if [ -f "$filename" ]; then
        i=1
        while [ -f "${filename}.i${i}" ]; do
            ((i++))
        done
        mv "$filename" "${filename}.i${i}"
        echo "Renamed $filename to ${filename}.i${i}"
    fi
}

# Check and rename files
rename_file "$file1"

mpirun -np 12 lmp -in in.lmp

rename_file "$file2"
rename_file "$file3"
